# Production deployment template for docker-compose.deploy.yml (VM 149 — prometheus.sparsa.dev).
# Copy to .env.deploy and fill before `docker compose -f docker-compose.deploy.yml --env-file .env.deploy up`.
# NEVER commit .env.deploy — it is git-ignored and docker-ignored.
# This file contains NO real credentials, only placeholders and documentation.

# Required: SQL Server connection string for Antares.
# Must point to the dedicated database approved for this deployment.
# Example format (replace placeholders, keep Encrypt/TrustServerCertificate as approved):
# Server=antares.sparsa.dev,1433;Database=Xigenia;User Id=<DB_USER>;Password=<STRONG_PASSWORD>;Encrypt=True;TrustServerCertificate=False
# The application will fail to start if this is missing or malformed.
ConnectionStrings__DefaultConnection=

# Required: Official Meta Model API key for server-side inference (Ai__Provider=Meta).
# Obtain from the Meta developer console. This deployment requires a nonempty value:
# docker compose rejects the API startup configuration when MetaAi__ApiKey is missing or empty,
# so the deployment cannot start without the key (there is no keyless 503-only mode here).
MetaAi__ApiKey=

# Optional overrides — defaults are set in docker-compose.deploy.yml:
# ASPNETCORE_ENVIRONMENT=Production
# Ai__Provider=Meta
# Cors__AllowedOrigins__0=https://xigenia.sparsa.dev
# API_BASE_URL (Web build arg) is baked as https://api.xigenia.sparsa.dev — no runtime override needed.

# Notes:
# - VM-facing ports: Web 8080 -> container 80, API 8081 -> container 8080.
# - Public origins: https://xigenia.sparsa.dev (Web), https://api.xigenia.sparsa.dev (API).
# - Network: Cloudflare Tunnel -> Vega Nginx Proxy Manager -> 192.168.10.149.
# - Do not add SQL Server to this deployment; Antares is external.

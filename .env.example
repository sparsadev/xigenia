# Local evaluator overrides. NEVER commit this file (it is git-ignored).
# Copy to .env and fill in values before running docker compose.

# Required: SQL Server system-administrator password (also used by the API).
SA_PASSWORD=ChooseAStrongPassword123!

# AI provider selection: Meta (default) or Baseten.
AI_PROVIDER=Meta

# Official Meta Model API key. Leave empty to run without AI inference;
# the financial-explanation endpoint then returns 503 and all other
# workflows keep working.
META_AI_API_KEY=

# Baseten application key. Only used when AI_PROVIDER=Baseten.
#BASETEN_API_KEY=

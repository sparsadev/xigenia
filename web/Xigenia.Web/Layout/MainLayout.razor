@inherits LayoutComponentBase
@using Xigenia.Web.Services
@inject AuthState Auth

<div class="page">
    <a class="skip-link" href="#xigenia-main-content">Skip to main content</a>
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row d-flex justify-content-between align-items-center gap-2 flex-wrap">
            <span class="text-muted small">Xigenia — Personal finance</span>
            <div class="d-flex align-items-center gap-2 gap-sm-3 ms-auto flex-wrap justify-content-end">
                <AppearanceSelector />
                @if (Auth.IsAuthenticated)
                {
                    <span class="identity-label small">@Auth.Email</span>
                }
                else
                {
                    <a href="login" class="small text-nowrap">Sign in</a>
                }
            </div>
        </div>

        <article id="xigenia-main-content" tabindex="-1" class="content">
            @Body
        </article>
    </main>
</div>

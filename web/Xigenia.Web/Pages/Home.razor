    private async Task CreateAccount()
    {
        if (_accountUncertain || AcctTxState.AccountUncertain) return;
        if (AcctTxState.AccountBusy && AcctTxState.AccountBusyVersion == Auth.SessionVersion) return;
        _accountSuccess = null;
        _accountError = null;
        var trimmedName = _accountName?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(trimmedName) || trimmedName.Length > 200)
        {
            _accountError = "Name is required and must be 1-200 characters.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_accountCurrency))
        {
            _accountError = "Currency is required.";
            return;
        }
        if (!IsValidMonetary(_accountOpeningBalance))
        {
            _accountError = "Amount must have at most two decimal places and be within supported range.";
            return;
        }
        if (_accountOpeningBalance < 0 && _accountType == FinancialAccountTypeDto.CreditCard)
        {
            _accountError = "Opening card debt must be ≥ 0.";
            return;
        }
        if (_accountType == FinancialAccountTypeDto.CreditCard)
        {
            if (_accountCreditLimit.HasValue)
            {
                if (!IsValidMonetary(_accountCreditLimit.Value))
                {
                    _accountError = "Credit limit must have at most two decimal places and be within supported range.";
                    return;
                }
                if (_accountCreditLimit.Value <= 0)
                {
                    _accountError = "Credit limit must be positive or empty.";
                    return;
                }
            }
            if (_accountStatementClosingDay.HasValue && (_accountStatementClosingDay.Value < 1 || _accountStatementClosingDay.Value > 31))
            {
                _accountError = "Statement closing day must be 1-31.";
                return;
            }
            if (_accountPaymentDueDay.HasValue && (_accountPaymentDueDay.Value < 1 || _accountPaymentDueDay.Value > 31))
            {
                _accountError = "Payment due day must be 1-31.";
                return;
            }
        }
        _accountBusy = true;
        _accountSubmitOwnerVersion = Auth.SessionVersion;
        AcctTxState.AccountBusy = true;
        AcctTxState.AccountBusyVersion = Auth.SessionVersion;
        AcctTxState.NotifyChanged();
        var version = Auth.SessionVersion;
        try
        {
            CreateFinancialAccountRequest req;
            if (_accountType == FinancialAccountTypeDto.CreditCard)
            {
                req = new CreateFinancialAccountRequest(trimmedName, _accountType, _accountCurrency.Trim().ToUpperInvariant(), _accountOpeningBalance, _accountCreditLimit, _accountStatementClosingDay, _accountPaymentDueDay);
            }
            else
            {
                req = new CreateFinancialAccountRequest(trimmedName, _accountType, _accountCurrency.Trim().ToUpperInvariant(), _accountOpeningBalance, null, null, null);
            }
            var res = await Api.CreateAccountAsync(req);
            if (_disposed) return;
            if (res.IsStale || version != Auth.SessionVersion) return;
            if (res.IsSuccess)
            {
                _accountSuccess = $"Account '{res.Data!.Name}' created. Balance {res.Data.CurrentBalance:0.00} {res.Data.Currency}.";
                ClearUncertainAccount();
                await RefreshAll();
            }
            else if (res.IsUncertain)
            {
                _accountUncertain = true;
                _accountUncertainDetail = res.Error?.Detail ?? "Uncertain outcome. Refresh to reconcile.";
                AcctTxState.AccountUncertain = true;
                AcctTxState.AccountUncertainDetail = res.Error?.Detail ?? "Uncertain outcome. Refresh to reconcile.";
                AcctTxState.NotifyChanged();
                _accountError = null;
            }
            else if (res.IsUnauthorized)
            {
                _accountError = "Session expired. Please sign in again.";
            }
            else if (res.IsValidationError)
            {
                var det = res.Error?.Detail ?? "Invalid account data.";
                if (res.Error?.ValidationErrors is not null)
                {
                    det += " " + string.Join(" ", res.Error.ValidationErrors.SelectMany(kv => kv.Value));
                }
                _accountError = det;
            }
            else
            {
                _accountError = res.Error?.Detail ?? "Server error.";
            }
        }
        catch (Exception ex) { if (!_disposed && version == Auth.SessionVersion) _accountError = ex.Message; }
        finally
        {
            if (AcctTxState.AccountBusyVersion == version)
            {
                AcctTxState.AccountBusy = false;
                AcctTxState.AccountBusyVersion = null;
                AcctTxState.NotifyChanged();
            }
            if (_accountSubmitOwnerVersion == version)
            {
                _accountBusy = false;
                _accountSubmitOwnerVersion = null;
            }
        }
    }

    private async Task CreateMovement()
    {
        if (_movementUncertain) return;
        if (_movementSubmitOwnerVersion.HasValue && _movementSubmitOwnerVersion.Value == Auth.SessionVersion) return;
        _movementSuccess = null;
        _movementError = null;
        if (_selectedAccountId == Guid.Empty)
        {
            _movementError = "Select an account.";
            return;
        }
        if (_movementAmount <= 0)
        {
            _movementError = "Amount must be greater than zero.";
            return;
        }
        if (_movementDate == DateOnly.MinValue)
        {
            _movementError = "Date is required.";
            return;
        }
        var account = _accounts?.FirstOrDefault(a => a.Id == _selectedAccountId);
        if (account is null)
        {
            _movementError = "Account not found.";
            return;
        }
        var direction = _movementKind == "income" ? MovementDirectionDto.Cobrar : MovementDirectionDto.Pagar;
        var classification = _movementKind == "income" ? MovementClassificationDto.Income : MovementClassificationDto.Expense;

        Guid? categoryId = null;
        if (SelectedCategoryId.HasValue)
        {
            var cat = _categoriesForMovement?.FirstOrDefault(c => c.Id == SelectedCategoryId.Value);
            if (cat is not null && cat.IsActive && cat.Classification == classification)
            {
                categoryId = cat.Id;
            }
            else
            {
                _movementError = "Selected category is not available or incompatible.";
                return;
            }
        }

        _movementBusy = true;
        _movementSubmitOwnerVersion = Auth.SessionVersion;
        var version = Auth.SessionVersion;
        try
        {
            var req = new CreateMoneyMovementRequest(direction, _movementAmount, account.Currency, _movementDate, string.IsNullOrWhiteSpace(_movementNote) ? null : _movementNote.Trim(), null, _selectedAccountId, classification, categoryId);
            var res = await Api.CreateMovementAsync(req);
            if (_disposed) return;
            if (res.IsStale || version != Auth.SessionVersion) return;
            if (res.IsSuccess)
            {
                _movementSuccess = $"{classification} of {res.Data!.Amount:0.00} {res.Data.Currency} recorded.";
                _movementAmount = 0;
                _movementNote = null;
                ClearUncertainMovement();
                await RefreshAll();
            }
            else if (res.IsUncertain)
            {
                _movementUncertain = true;
                _movementUncertainDetail = res.Error?.Detail ?? "Uncertain outcome. Refresh to reconcile.";
                _movementError = null;
            }
            else if (res.IsUnauthorized)
            {
                _movementError = "Session expired. Please sign in again.";
            }
            else if (res.IsValidationError)
            {
                var det = res.Error?.Detail ?? "Invalid movement.";
                if (res.Error?.ValidationErrors is not null)
                {
                    det += " " + string.Join(" ", res.Error.ValidationErrors.SelectMany(kv => kv.Value));
                }
                _movementError = det;
            }
            else
            {
                _movementError = res.Error?.Detail ?? "Server error.";
            }
        }
        catch (Exception ex) { if (!_disposed && version == Auth.SessionVersion) _movementError = ex.Message; }
        finally { if (!_disposed && _movementSubmitOwnerVersion == version) { _movementBusy = false; _movementSubmitOwnerVersion = null; } else if (!_disposed && version != Auth.SessionVersion) { /* stale completion does not unlock new session */ } }
    }

    private async Task ReconcileAccounts()
    {
        if (_refreshOwnerVersion.HasValue && _refreshOwnerVersion.Value == Auth.SessionVersion) return;
        _reconciling = true;
        try
        {
            await RefreshAll();
            // Keep warning until user explicitly acknowledges — do not auto-clear uncertain.
        }
        finally { _reconciling = false; }
    }

    private async Task ReconcileMovements()
    {
        if (_refreshOwnerVersion.HasValue && _refreshOwnerVersion.Value == Auth.SessionVersion) return;
        _reconciling = true;
        try
        {
            await RefreshAll();
        }
        finally { _reconciling = false; }
    }

    private void AcknowledgeAccountUncertainty()
    {
        ClearUncertainAccount();
    }

    private void AcknowledgeMovementUncertainty()
    {
        ClearUncertainMovement();
    }

    private static bool IsValidMonetary(decimal value)
    {
        const decimal max = 9999999999999999.99m;
        if (value < -max || value > max) return false;
        var bits = decimal.GetBits(value);
        var scale = (bits[3] >> 16) & 0x7F;
        return scale <= 2;
    }

    private void ClearUncertainAccount()
    {
        _accountUncertain = false;
        _accountUncertainDetail = null;
    }

    private void ClearUncertainMovement()
    {
        _movementUncertain = false;
        _movementUncertainDetail = null;
    }

    private readonly AiExplanationPanelState _aiPanel = new();
    private readonly string[] _aiSuggestions = new[]
    {
        "Summarize my recent spending.",
        "How did my balance change?",
        "Where did most of my expenses go?"
    };

    private void UseSuggestion(string suggestion) => _aiPanel.SelectSuggestion(suggestion);

    private async Task RequestExplanation()
    {
        var version = Auth.SessionVersion;
        if (!_aiPanel.TryBegin(out var requestVersion, version)) return; // busy or invalid; never duplicates a pending request
        try
        {
            var res = await Api.RequestFinancialExplanationAsync(new FinancialExplanationRequest(_aiPanel.Question.Trim()));
            // Display only; never recalculate balances from AI output.
            if (res.IsSuccess)
            {
                _aiPanel.ApplySuccess(requestVersion, Auth.SessionVersion, _disposed, res.Data);
            }
            else if (res.IsUnauthorized)
            {
                _aiPanel.ApplyError(requestVersion, Auth.SessionVersion, _disposed, "Session expired. Please sign in again.");
            }
            else if (res.IsValidationError)
            {
                _aiPanel.ApplyError(requestVersion, Auth.SessionVersion, _disposed, res.Error?.Detail ?? "Invalid question.");
            }
            else if (res.IsUncertain)
            {
                _aiPanel.ApplyError(requestVersion, Auth.SessionVersion, _disposed, res.Error?.Detail ?? "Request could not be completed. It is safe to try again.");
            }
            else if (!res.IsStale)
            {
                _aiPanel.ApplyError(requestVersion, Auth.SessionVersion, _disposed, res.Error?.Detail ?? "Server error. Try again later.");
            }
        }
        catch (Exception ex) { _aiPanel.ApplyError(requestVersion, Auth.SessionVersion, _disposed, ex.Message); }
        finally { _aiPanel.Finish(requestVersion, Auth.SessionVersion, _disposed); }
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        Auth.OnChange -= HandleAuthChange;
        AcctTxState.OnChange -= HandleAccountTransferStateChanged;
    }
}

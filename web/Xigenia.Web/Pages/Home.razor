@page "/"
@implements IDisposable
@using Xigenia.Web.Models
@using Xigenia.Web.Services
@inject ApiClient Api
@inject AuthState Auth
@inject NavigationManager Nav
@inject AccountTransferMutationState AcctTxState

<PageTitle>Xigenia — Home</PageTitle>

<div class="container py-4">
    @if (!Auth.IsAuthenticated)
    {
        <div class="card p-4 shadow-sm">
            <h1 class="h4">Xigenia</h1>
            <p class="text-muted">Your personal finance assistant. Sign in to manage accounts and movements.</p>
            <a class="btn btn-primary" href="/login">Sign in</a>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h1 class="h4 mb-0">Dashboard</h1>
            <span class="text-muted small">Signed in as @Auth.Email</span>
        </div>

        <div class="finance-dashboard">

                <section class="finance-summary-section mb-3" aria-labelledby="summary-heading">
                <div class="card p-3 h-100" aria-busy="@_loadingSummary.ToString().ToLowerInvariant()">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <h2 id="summary-heading" class="h6 mb-0">Summary</h2>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAll" disabled="@(_loadingAccounts || _loadingMovements || _loadingSummary || _reconciling || _refreshOwnerVersion.HasValue)">Refresh</button>
                    </div>
                    @if (_loadingSummary)
                    {
                        <p class="text-muted small" role="status" aria-live="polite" aria-busy="true">Loading…</p>
                    }
                    else if (_summaryError is not null)
                    {
                        <div class="alert alert-danger py-2" role="alert" aria-live="assertive">@_summaryError</div>
                    }
                    else if (_summary is null || _summary.Totals.Count == 0)
                    {
                        <p class="text-muted small" role="status" aria-live="polite">No movements yet.</p>
                    }
                    else
                    {
                        <div class="row g-3">
                        @foreach (var t in _summary.Totals)
                        {
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="finance-currency-block border rounded p-3 h-100">
                                    <div class="finance-currency-label small text-muted text-uppercase fw-semibold mb-2">@t.Currency</div>
                                    <dl class="mb-0">
                                        <dt class="small text-muted">Net</dt>
                                        <dd class="finance-net h5 mb-2">@t.Net.ToString("0.00") <span class="finance-currency-code small fw-normal text-muted">@t.Currency</span></dd>
                                        <dt class="small text-muted">Income</dt>
                                        <dd class="small mb-1">@t.Income.ToString("0.00") @t.Currency</dd>
                                        <dt class="small text-muted">Expenses</dt>
                                        <dd class="small mb-1">@t.Expenses.ToString("0.00") @t.Currency</dd>
                                        <dt class="small text-muted">Movements</dt>
                                        <dd class="small text-muted mb-0">@t.MovementCount</dd>
                                    </dl>
                                </div>
                            </div>
                        }
                        </div>
                        @if (_summary.InternalTransferCount > 0)
                        {
                            <small class="text-muted d-block mt-3">Transfers excluded: @_summary.InternalTransferCount</small>
                        }
                    }
                </div>
            </section>

        <div class="row g-3">
<div class="col-12 col-lg-6">
                <div class="card p-3 h-100">
                    <h2 class="h6">Create account</h2>
                    @if (!string.IsNullOrWhiteSpace(_accountSuccess))
                    {
                        <div class="alert alert-success py-2" role="status" aria-live="polite">@_accountSuccess</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_accountError))
                    {
                        <div class="alert alert-danger py-2" role="alert" aria-live="assertive">@_accountError</div>
                    }
                    @if (_accountUncertain)
                    {
                        <div class="alert alert-warning py-2" role="alert" aria-live="assertive">
                            <strong>Uncertain outcome.</strong> @_accountUncertainDetail
                            <p class="mb-2 mt-2 small">The request may have completed. Refresh and check your records. Refresh alone does not enable retry. Use ‘I checked — allow retry’ only after reviewing the result.</p>
                            <div class="mt-2 d-flex gap-2 flex-wrap">
                                <button class="btn btn-sm btn-outline-primary" @onclick="ReconcileAccounts" disabled="@(_reconciling || _refreshOwnerVersion.HasValue || _loadingAccounts || _loadingMovements || _loadingSummary)">Refresh to reconcile</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="AcknowledgeAccountUncertainty">I checked — allow retry</button>
                            </div>
                            <small class="d-block mt-1">Refresh is read-only and does not unlock submission. Review your records before acknowledging.</small>
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label" for="account-name">Name</label>
                        <input id="account-name" name="account-name" class="form-control" @bind="_accountName" placeholder="Primary USD" disabled="@_accountUncertain" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="account-currency">Currency (ISO 4217)</label>
                        <input id="account-currency" name="account-currency" class="form-control" @bind="_accountCurrency" placeholder="USD" maxlength="3" style="text-transform:uppercase" disabled="@_accountUncertain" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="account-opening-balance">@(_accountType == FinancialAccountTypeDto.CreditCard ? "Opening card debt" : "Opening balance")</label>
                        <input id="account-opening-balance" name="account-opening-balance" class="form-control" type="number" step="0.01" @bind="_accountOpeningBalance" disabled="@_accountUncertain" />
                        @if (_accountType == FinancialAccountTypeDto.CreditCard)
                        {
                            <small class="text-muted">Enter opening debt, not available cash. Must be ≥ 0.</small>
                        }
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="account-type">Type</label>
                        <select id="account-type" name="account-type" class="form-select" @bind="_accountType" disabled="@_accountUncertain">
                            <option value="@FinancialAccountTypeDto.BankAccount">Bank account</option>
                            <option value="@FinancialAccountTypeDto.Cash">Cash</option>
                            <option value="@FinancialAccountTypeDto.DigitalWallet">Digital wallet</option>
                            <option value="@FinancialAccountTypeDto.CreditCard">Credit card</option>
                        </select>
                    </div>
                    @if (_accountType == FinancialAccountTypeDto.CreditCard)
                    {
                        <div class="mb-2">
                            <label class="form-label" for="account-credit-limit">Credit limit (optional)</label>
                            <input id="account-credit-limit" name="account-credit-limit" class="form-control" type="number" step="0.01" @bind="_accountCreditLimit" placeholder="5000" disabled="@_accountUncertain" />
                            <small class="text-muted">Positive, leave blank if none.</small>
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="account-statement-day">Statement closing day (1-31, optional)</label>
                            <input id="account-statement-day" name="account-statement-day" class="form-control" type="number" min="1" max="31" @bind="_accountStatementClosingDay" placeholder="28" disabled="@_accountUncertain" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="account-due-day">Payment due day (1-31, optional)</label>
                            <input id="account-due-day" name="account-due-day" class="form-control" type="number" min="1" max="31" @bind="_accountPaymentDueDay" placeholder="15" disabled="@_accountUncertain" />
                        </div>
                    }
                    <button class="btn btn-primary w-100" @onclick="CreateAccount" disabled="@(AcctTxState.AccountBusy || _accountUncertain || AcctTxState.AccountUncertain)">
                        @if (AcctTxState.AccountBusy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        @(AcctTxState.AccountBusy ? "Creating…" : "Create account")
                    </button>
                    @if (AcctTxState.AccountBusy)
                    {
                        <p class="small text-muted mt-2 mb-0" role="status" aria-live="polite">Creating account…</p>
                    }
                </div>
            </div>
<div class="col-12 col-lg-6">
                <div class="card p-3 h-100" aria-busy="@_loadingAccounts.ToString().ToLowerInvariant()">
                    <h2 class="h6">Add movement</h2>
                    @if (_movementUncertain)
                    {
                        <div class="alert alert-warning py-2" role="alert" aria-live="assertive">
                            <strong>Uncertain outcome.</strong> @_movementUncertainDetail
                            <p class="mb-2 mt-2 small">The request may have completed. Refresh and check your records. Refresh alone does not enable retry. Use ‘I checked — allow retry’ only after reviewing the result.</p>
                            <div class="mt-2 d-flex gap-2 flex-wrap">
                                <button class="btn btn-sm btn-outline-primary" @onclick="ReconcileMovements" disabled="@(_reconciling || _refreshOwnerVersion.HasValue || _loadingAccounts || _loadingMovements || _loadingSummary)">Refresh to reconcile</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="AcknowledgeMovementUncertainty">I checked — allow retry</button>
                            </div>
                            <small class="d-block mt-1">Refresh is read-only and does not unlock submission. Review your records before acknowledging.</small>
                        </div>
                    }
                    @if (_loadingAccounts)
                    {
                        <div role="status" aria-live="polite" aria-busy="true" class="d-flex align-items-center gap-2 py-2">
                            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                            <span class="text-muted small">Loading accounts…</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(_accountsError))
                    {
                        <div class="alert alert-danger py-2" role="alert" aria-live="assertive">@_accountsError</div>
                        <p class="small text-muted mb-2">Unable to load accounts. Refresh to try again.</p>
                        @if (Auth.IsAuthenticated)
                        {
                            @if (_reconciling || _refreshOwnerVersion.HasValue || _loadingAccounts || _loadingMovements || _loadingSummary)
                            {
                                <p class="small text-muted" role="status" aria-live="polite">Refreshing…</p>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAll">Refresh</button>
                            }
                        }
                        else
                        {
                            <p class="small text-muted">Accounts are unavailable. Please try again later.</p>
                        }
                    }
                    else if (_accounts is null)
                    {
                        <div class="alert alert-danger py-2" role="alert" aria-live="assertive">Account data is unavailable. Refresh to try again.</div>
                        @if (Auth.IsAuthenticated)
                        {
                            @if (_reconciling || _refreshOwnerVersion.HasValue || _loadingAccounts || _loadingMovements || _loadingSummary)
                            {
                                <p class="small text-muted" role="status" aria-live="polite">Refreshing…</p>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshAll">Refresh</button>
                            }
                        }
                        else
                        {
                            <p class="small text-muted">Accounts are unavailable. Please try again later.</p>
                        }
                    }
                    else if (_accounts.Count == 0)
                    {
                        <p class="text-muted small" role="status" aria-live="polite">Create an account first.</p>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(_movementSuccess))
                        {
                            <div class="alert alert-success py-2" role="status" aria-live="polite">@_movementSuccess</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_movementError))
                        {
                            <div class="alert alert-danger py-2" role="alert" aria-live="assertive">@_movementError</div>
                        }
                        <div class="mb-2">
                            <label class="form-label" for="movement-account">Account</label>
                            <select id="movement-account" name="movement-account" class="form-select" @bind="_selectedAccountId" disabled="@_movementUncertain">
                                @foreach (var a in _accounts)
                                {
                                    <option value="@a.Id">@a.Name (@a.Currency) — @a.CurrentBalance.ToString("0.00")</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="movement-kind">Type</label>
                            <select id="movement-kind" name="movement-kind" class="form-select" @bind="MovementKindBound" disabled="@_movementUncertain">
                                <option value="income">Income (Cobrar / Income)</option>
                                <option value="expense">Expense (Pagar / Expense)</option>
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="movement-category">Category (optional)</label>
                            <select id="movement-category" name="movement-category" class="form-select" @bind="_selectedCategoryIdString" disabled="@_movementUncertain">
                                <option value="">No category</option>
                                @if (_categoriesForMovement is not null)
                                {
                                    @foreach (var cat in GetCompatibleCategories())
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </select>
                            @if (_categoriesForMovement is null && _loadingCategories) { <small class="text-muted">Loading categories…</small> }
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="movement-amount">Amount</label>
                            <input id="movement-amount" name="movement-amount" class="form-control" type="number" step="0.01" @bind="_movementAmount" disabled="@_movementUncertain" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="movement-date">Date</label>
                            <input id="movement-date" name="movement-date" class="form-control" type="date" @bind="_movementDate" disabled="@_movementUncertain" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="movement-note">Note (optional)</label>
                            <input id="movement-note" name="movement-note" class="form-control" @bind="_movementNote" placeholder="Salary, groceries..." disabled="@_movementUncertain" />
                        </div>
                        <button class="btn btn-primary w-100" @onclick="CreateMovement" disabled="@(_movementBusy || _accounts.Count == 0 || _movementUncertain)">
                            @if (_movementBusy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                            @(_movementBusy ? "Recording…" : "Record movement")
                        </button>
                        @if (_movementBusy)
                        {
                            <p class="small text-muted mt-2 mb-0" role="status" aria-live="polite">Recording movement…</p>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="row g-3 mt-3">
            <div class="col-12 col-lg-6">
                <div class="card p-3" aria-busy="@_loadingAccounts.ToString().ToLowerInvariant()">
                    <h2 class="h6">Accounts</h2>
                    @if (_loadingAccounts)
                    {
                        <p class="text-muted small" role="status" aria-live="polite" aria-busy="true">Loading accounts…</p>
                    }
                    else if (_accountsError is not null)
                    {
                        <div class="alert alert-danger py-2" role="alert" aria-live="assertive">@_accountsError</div>
                    }
                    else if (_accounts is null || _accounts.Count == 0)
                    {
                        <p class="text-muted small" role="status" aria-live="polite">No accounts yet. Create one above.</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead><tr><th>Name</th><th>Currency</th><th class="text-end">Opening balance</th><th class="text-end">Current balance</th></tr></thead>
                                <tbody>
                                    @foreach (var a in _accounts)
                                    {
                                        <tr>
                                            <td><a href="@($"/accounts/{a.Id}")">@a.Name</a></td>
                                            <td>@a.Currency</td>
                                            <td class="text-end">@a.OpeningBalance.ToString("0.00") @a.Currency</td>
                                            <td class="text-end">@a.CurrentBalance.ToString("0.00") @a.Currency</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card p-3 finance-movement-history" aria-busy="@_loadingMovements.ToString().ToLowerInvariant()">
                    <h2 id="movement-history-heading" class="h6">Movement history</h2>
                    @if (_loadingMovements)
                    {
                        <p class="text-muted small" role="status" aria-live="polite" aria-busy="true">Loading movements…</p>
                    }
                    else if (_movementsError is not null)
                    {
                        <div class="alert alert-danger py-2" role="alert" aria-live="assertive">@_movementsError</div>
                    }
                    else if (_movements is null || _movements.Count == 0)
                    {
                        <p class="text-muted small" role="status" aria-live="polite">No movements yet. Record income or expense above.</p>
                    }
                    else
                    {
                        <div class="table-responsive finance-history-scroll finance-history-region" tabindex="0" role="region" aria-labelledby="movement-history-heading">
                            <table class="table table-sm mb-0 finance-history-table">
                                <caption class="visually-hidden">Recorded movements</caption>
                                <thead><tr><th scope="col">Date</th><th scope="col">Account / note</th><th scope="col">Classification</th><th scope="col">Direction</th><th scope="col" class="text-end">Amount</th></tr></thead>
                                <tbody>
                                    @foreach (var m in _movements.OrderByDescending(x => x.MovementDate).ThenByDescending(x => x.Amount))
                                    {
                                        <tr>
                                            <td>@m.MovementDate.ToString("yyyy-MM-dd")</td>
                                            <td class="finance-account-note-cell">
                                                @{
                                                    string accountLabel;
                                                    if (!m.FinancialAccountId.HasValue || m.FinancialAccountId.Value == Guid.Empty)
                                                    {
                                                        // Null remains No linked account per contract, including during loading/error
                                                        if (!m.FinancialAccountId.HasValue)
                                                        {
                                                            accountLabel = "No linked account";
                                                        }
                                                        else
                                                        {
                                                            accountLabel = "Account unavailable";
                                                        }
                                                    }
                                                    else if (_loadingAccounts)
                                                    {
                                                        accountLabel = "Loading account…";
                                                    }
                                                    else if (_accountsError is not null)
                                                    {
                                                        accountLabel = "Account unavailable";
                                                    }
                                                    else if (_accounts is null)
                                                    {
                                                        accountLabel = "Account unavailable";
                                                    }
                                                    else
                                                    {
                                                        var acct = _accounts.FirstOrDefault(a => a.Id == m.FinancialAccountId.Value);
                                                        if (acct is null)
                                                        {
                                                            accountLabel = "Account unavailable";
                                                        }
                                                        else if (string.IsNullOrWhiteSpace(acct.Name))
                                                        {
                                                            accountLabel = "Account unavailable";
                                                        }
                                                        else
                                                        {
                                                            accountLabel = acct.Name;
                                                        }
                                                    }
                                                }
                                                <div>@accountLabel</div>
                                                @if (!string.IsNullOrWhiteSpace(m.Note))
                                                {
                                                    <div class="small text-muted finance-note">@m.Note</div>
                                                }
                                            </td>
                                            <td>@m.Classification</td>
                                            <td>@m.Direction</td>
                                            <td class="text-end">@m.Amount.ToString("0.00") @m.Currency</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <small class="text-muted">Showing @_movements.Count movement(s).</small>
                    }
                </div>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-12">
                <div class="card p-3">
                    <h2 class="h6">Financial insights</h2>
                    <p class="text-muted small mb-2">Ask for a plain-language explanation of your recorded finances. Answers are generated from your deterministic records and are not authoritative calculations.</p>
                    <div class="d-flex gap-2 flex-wrap mb-2">
                        @foreach (var suggestion in _aiSuggestions)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => UseSuggestion(suggestion)" disabled="@_aiPanel.IsBusy">@suggestion</button>
                        }
                    </div>
                    <div class="mb-2">
                        <label class="form-label" for="ai-question">Question</label>
                        <input id="ai-question" name="ai-question" class="form-control" @bind="_aiPanel.Question" placeholder="e.g. Where did most of my expenses go?" maxlength="1000" disabled="@_aiPanel.IsBusy" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_aiPanel.Error))
                    {
                        <div class="alert alert-danger py-2" role="alert" aria-live="assertive">@_aiPanel.Error</div>
                    }
                    @if (_aiPanel.Response is not null)
                    {
                        <div class="border rounded p-2 mb-2">
                            <p class="mb-1" style="white-space:pre-wrap">@_aiPanel.Response.Explanation</p>
                            <small class="text-muted">Explained by @_aiPanel.Response.Provider / @_aiPanel.Response.Model · @_aiPanel.Response.GeneratedAt.ToString("yyyy-MM-dd HH:mm") UTC</small>
                        </div>
                        <div class="alert alert-info py-2 mb-2">@_aiPanel.Response.Disclaimer</div>
                    }
                    <button class="btn btn-primary" @onclick="RequestExplanation" disabled="@(_aiPanel.IsBusy || string.IsNullOrWhiteSpace(_aiPanel.Question))">
                        @if (_aiPanel.IsBusy) { <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> }
                        @( _aiPanel.IsBusy ? "Generating…" : "Explain my finances" )
                    </button>
                </div>
            </div>
        </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<FinancialAccountResponse>? _accounts;
    private IReadOnlyList<MoneyMovementResponse>? _movements;
    private MoneyMovementSummaryResponse? _summary;

    private bool _loadingAccounts, _loadingMovements, _loadingSummary, _reconciling, _disposed;
    private int? _refreshOwnerVersion;
    private int? _loadedAccountsVersion;
    private int _lastSeenTransferSuccessRevision;
    private string? _accountsError, _movementsError, _summaryError;

    private string _accountName = "Primary USD";
    private string _accountCurrency = "USD";
    private decimal _accountOpeningBalance = 1000.00m;
    private FinancialAccountTypeDto _accountType = FinancialAccountTypeDto.BankAccount;
    private decimal? _accountCreditLimit;
    private int? _accountStatementClosingDay;
    private int? _accountPaymentDueDay;
    private bool _accountBusy;
    private int? _accountSubmitOwnerVersion;
    private bool _accountUncertain;
    private string? _accountUncertainDetail;
    private string? _accountSuccess, _accountError;

    private Guid _selectedAccountId;
    private string _movementKind = "income";
    private string _selectedCategoryIdString = string.Empty;
    private IReadOnlyList<FinancialCategoryResponse>? _categoriesForMovement;
    private bool _loadingCategories;
    private string? _categoriesError;
    private int? _movementSubmitOwnerVersion;
    private decimal _movementAmount = 0;
    private DateOnly _movementDate = DateOnly.FromDateTime(DateTime.Today);
    private string? _movementNote;
    private bool _movementBusy;
    private bool _movementUncertain;
    private string? _movementUncertainDetail;
    private string? _movementSuccess, _movementError;

    private string MovementKindBound
    {
        get => _movementKind;
        set
        {
            if (_movementKind == value) return;
            _movementKind = value;
            ClearIncompatibleCategory();
        }
    }

    private Guid? SelectedCategoryId => Guid.TryParse(_selectedCategoryIdString, out var g) && g != Guid.Empty ? g : null;

    private IEnumerable<FinancialCategoryResponse> GetCompatibleCategories()
    {
        if (_categoriesForMovement is null) return Array.Empty<FinancialCategoryResponse>();
        var needed = _movementKind == "income" ? MovementClassificationDto.Income : MovementClassificationDto.Expense;
        return _categoriesForMovement.Where(c => c.IsActive && c.Classification == needed);
    }

    private void ClearIncompatibleCategory()
    {
        if (string.IsNullOrWhiteSpace(_selectedCategoryIdString)) return;
        if (!Guid.TryParse(_selectedCategoryIdString, out var id)) { _selectedCategoryIdString = string.Empty; return; }
        var cat = _categoriesForMovement?.FirstOrDefault(c => c.Id == id);
        if (cat is null || !cat.IsActive) { _selectedCategoryIdString = string.Empty; return; }
        var needed = _movementKind == "income" ? MovementClassificationDto.Income : MovementClassificationDto.Expense;
        if (cat.Classification != needed) _selectedCategoryIdString = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.OnChange += HandleAuthChange;
        AcctTxState.OnChange += HandleAccountTransferStateChanged;
        AcctTxState.EnsureOwner();
        _accountBusy = AcctTxState.AccountBusy && AcctTxState.AccountBusyVersion == Auth.SessionVersion;
        _accountSubmitOwnerVersion = AcctTxState.AccountBusyVersion;
        _accountUncertain = AcctTxState.AccountUncertain;
        _accountUncertainDetail = AcctTxState.AccountUncertainDetail;
        _lastSeenTransferSuccessRevision = AcctTxState.TransferSuccessRevision;
        if (Auth.IsAuthenticated)
        {
            await RefreshAll();
        }
    }

    private void HandleAccountTransferStateChanged()
    {
        if (_disposed) return;
        if (_loadedAccountsVersion.HasValue && _loadedAccountsVersion.Value != Auth.SessionVersion)
        {
            _accounts = null;
            _accountsError = null;
            _loadingAccounts = Auth.IsAuthenticated;
            _accountName = string.Empty;
            _accountCurrency = string.Empty;
            _accountOpeningBalance = 0;
            _accountCreditLimit = null;
            _accountStatementClosingDay = null;
            _accountPaymentDueDay = null;
        }
        if (_lastSeenTransferSuccessRevision != AcctTxState.TransferSuccessRevision)
        {
            _lastSeenTransferSuccessRevision = AcctTxState.TransferSuccessRevision;
            _refreshOwnerVersion = null;
            _ = InvokeAsync(async () =>
            {
                await RefreshAll();
                await InvokeAsync(StateHasChanged);
            });
            return;
        }
        if (Auth.SessionVersion != AcctTxState.AccountBusyVersion && _accountBusy)
        {
            _accountBusy = false;
            _accountSubmitOwnerVersion = null;
        }
        else
        {
            _accountBusy = AcctTxState.AccountBusy && AcctTxState.AccountBusyVersion == Auth.SessionVersion;
            _accountSubmitOwnerVersion = AcctTxState.AccountBusyVersion;
        }
        _accountUncertain = AcctTxState.AccountUncertain && AcctTxState.AccountUncertainDetail != null;
        if (AcctTxState.AccountUncertain) _accountUncertainDetail = AcctTxState.AccountUncertainDetail;
        _ = InvokeAsync(StateHasChanged);
    }

    private async void HandleAuthChange()
    {
        if (_disposed) return;
        // Clear AI-sensitive state on every session transition — logout and direct
        // authenticated replacement alike — so the new session never sees the
        // previous session's question, explanation, error, or pending result.
        _aiPanel.Clear();
        if (!Auth.IsAuthenticated)
        {
            ClearSensitiveState();
            await InvokeAsync(StateHasChanged);
            return;
        }
        // Clear prior session's financial-uncertainty locks/details before
        // loading the new identity's data (D1). The originating session's
        // lock is not cleared mid-session — only on identity boundary.
        ClearSensitiveState();
        await RefreshAll();
        if (!_disposed) await InvokeAsync(StateHasChanged);
    }

    private void ClearSensitiveState()
    {
        _accounts = null;
        _movements = null;
        _summary = null;
        _accountsError = _movementsError = _summaryError = null;
        _accountSuccess = _accountError = null;
        _movementSuccess = _movementError = null;
        _selectedAccountId = Guid.Empty;
        _selectedCategoryIdString = string.Empty;
        _categoriesForMovement = null;
        _categoriesError = null;
        _loadingCategories = false;
        _movementBusy = false;
        _movementSubmitOwnerVersion = null;
        _accountName = string.Empty;
        _accountCurrency = string.Empty;
        _accountOpeningBalance = 0;
        _accountCreditLimit = null;
        _accountStatementClosingDay = null;
        _accountPaymentDueDay = null;
        // Clear session-owned uncertainty locks and details on identity boundary
        // to prevent cross-session disclosure (D1). Locks remain while the
        // originating session stays active; they are not cleared mid-session.
        _accountUncertain = false;
        _movementUncertain = false;
        _accountUncertainDetail = null;
        _movementUncertainDetail = null;
        _refreshOwnerVersion = null;
    }

    private async Task RefreshAll()
    {
        if (_disposed || !Auth.IsAuthenticated) return;
        var version = Auth.SessionVersion;
        if (_refreshOwnerVersion.HasValue && _refreshOwnerVersion.Value == version) return;
        _refreshOwnerVersion = version;
        try
        {
            await Task.WhenAll(LoadAccountsCore(version), LoadMovementsCore(version), LoadSummaryCore(version), LoadCategoriesForMovementCore(version));
        if (_disposed) return;
        if (version != Auth.SessionVersion) return; // stale session, discard selection update
        if (_accounts is not null && _accounts.Count > 0 && _selectedAccountId == Guid.Empty)
        {
            _selectedAccountId = _accounts[0].Id;
        }
            StateHasChanged();
        }
        finally
        {
            if (_refreshOwnerVersion.HasValue && _refreshOwnerVersion.Value == version) _refreshOwnerVersion = null;
        }
    }

    private async Task LoadAccounts()
    {
        if (_disposed || !Auth.IsAuthenticated) return;
        await LoadAccountsCore(Auth.SessionVersion);
    }

    private async Task LoadAccountsCore(int requestVersion)
    {
        _loadingAccounts = true;
        _accountsError = null;
        try
        {
            var res = await Api.ListAccountsAsync();
            if (_disposed) return;
            if (res.IsStale || requestVersion != Auth.SessionVersion) return;
            if (res.IsSuccess) { _accounts = res.Data ?? Array.Empty<FinancialAccountResponse>(); _loadedAccountsVersion = requestVersion; }
            else if (res.IsUncertain) _accountsError = res.Error?.Detail ?? "Unable to confirm accounts.";
            else if (res.IsUnauthorized) _accountsError = "Session expired. Please sign in again.";
            else if (res.IsValidationError) _accountsError = res.Error?.Detail ?? "Validation error.";
            else _accountsError = res.Error?.Detail ?? "Server error.";
        }
        catch (Exception ex)
        {
            if (!_disposed && requestVersion == Auth.SessionVersion) _accountsError = ex.Message;
        }
        finally { if (!_disposed && requestVersion == Auth.SessionVersion) _loadingAccounts = false; }
    }

